class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {
        vector<int> a = nums1;
        vector<int> b = nums2;

        a.insert(a.end(), b.begin(), b.end());
        sort(a.begin(), a.end());

        int n = a.size();

        if (n % 2 == 1) {
            return a[n / 2];
        }

        return ((double)a[n / 2 - 1] + a[n / 2]) / 2.0;
    }
};
