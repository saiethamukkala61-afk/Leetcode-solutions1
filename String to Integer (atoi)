class Solution {
public:
    int myAtoi(string s) {
        int i = 0;
        int n = s.length();
        int sign = 1;
        long long num = 0;

        // 1. Skip leading whitespaces
        while (i < n && s[i] == ' ') {
            i++;
        }

        // 2. Check the sign
        if (i < n && (s[i] == '+' || s[i] == '-')) {
            if (s[i] == '-') {
                sign = -1;
            }
            i++;
        }

        // 3. Convert digits to integer
        while (i < n && s[i] >= '0' && s[i] <= '9') {
            num = num * 10 + (s[i] - '0');

            // 4. Handle 32-bit integer overflow
            if (sign * num >= INT_MAX) {
                return INT_MAX;
            }

            if (sign * num <= INT_MIN) {
                return INT_MIN;
            }

            i++;
        }

        return (int)(sign * num);
    }
};
